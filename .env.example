# ── Christian Debate Platform — Production Environment Variables ──

# Postgres
POSTGRES_PASSWORD=change_me_to_a_secure_password

# Auth
AUTH_SECRET=generate_with_openssl_rand_base64_32

# Hub
HUB_PUBLIC_URL=https://hub.yourdomain.com
HUB_ADMIN_EMAIL=admin@yourdomain.com
HUB_ADMIN_PASSWORD=change_me
HUB_ADMIN_TOKEN=generate_a_secure_random_token

# Site
SITE_PUBLIC_URL=https://site.yourdomain.com

# Federation (only needed when running with Hub)
AGORA_HUB_URL=http://hub:4000
AGORA_SITE_CLIENT_ID=your_site_client_id
AGORA_SITE_CLIENT_SECRET=your_site_client_secret

# Optional: SMTP for email
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=change_me

# Nginx / TLS
# DOMAIN_SITE=site.yourdomain.com
# DOMAIN_HUB=hub.yourdomain.com
